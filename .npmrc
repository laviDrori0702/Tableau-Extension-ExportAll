# @tableau/tableau-ui declares a react@^16 peer in every published version (incl.
# 3.2.0, which this project has always shipped) while the app runs react 17. npm 6
# ignored that; npm 7+ errors on it. Nothing here upgrades to satisfy the peer -
# react stays on 17 and tableau-ui on 3.x - so the mismatch is accepted explicitly
# instead of needing --legacy-peer-deps on every install and on CI's `npm ci`.
legacy-peer-deps=true
